{
  "name": "wexample/php-schema-org",
  "description": "The schema.org vocabulary of a release, to check a description against and write its values as schema.org reads them",
  "version": "1.1.0",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "autoload": {
    "psr-4": {
      "Wexample\\PhpSchemaOrg\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\PhpSchemaOrg\\Tests\\": "tests/"
    }
  }
}